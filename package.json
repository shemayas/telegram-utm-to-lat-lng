{
  "name": "telegram-map-bot",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run build:dev\" \"vercel dev\"",
    "build:dev": "ncc build api/webhook.ts --external utm --watch",
    "build": "ncc build api/webhook.ts -o dist --external utm -m",
    "deploy:prod": "npm run build && vercel --prod",
    "start": "vercel dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/utm": "^1.1.4",
    "@vercel/node": "^5.5.5",
    "dotenv": "^17.2.2",
    "node-telegram-bot-api": "^0.66.0",
    "utm": "^1.1.1"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/node": "^24.5.1",
    "@types/node-telegram-bot-api": "^0.64.11",
    "@vercel/ncc": "^0.38.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
